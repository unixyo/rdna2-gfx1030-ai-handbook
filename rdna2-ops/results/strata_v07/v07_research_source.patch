index 000000000..c0156b7a9
--- /dev/null
+++ b/tests/hip/prefill_mmq_v07.cpp
@@ -0,0 +1,184 @@
+// v0.7: exact-output and paired-timing screen of RDNA2 grouped MMQ J selection.
+// Uses distinct experts from the existing native pack; no model or weights are downloaded.
+#include "strata/prefill/moe_mmq.hpp"
+#include "ggml.h"
+#include <hip/hip_runtime.h>
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <numeric>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+using namespace strata::prefill::mmq;
+static void ck(hipError_t e, const char *what) {
+    if (e != hipSuccess) throw std::runtime_error(std::string(what)+": "+hipGetErrorString(e));
+}
+struct Buf {
+    void *p=nullptr;
+    explicit Buf(size_t n) { ck(hipMalloc(&p,n),"alloc"); }
+    ~Buf() { if(p) hipFree(p); }
+    template<class T> T *as() { return static_cast<T*>(p); }
+};
+struct Pack {
+    int layer=-1, gt=-1, dt=-1;
+    uint64_t offset=0, blob=0;
+    std::vector<std::vector<uint8_t>> gu, down;
+};
+static Pack load_pack(const std::string &path) {
+    Pack p; std::ifstream meta(path+"/native_experts.txt"); std::string line;
+    while(std::getline(meta,line)) {
+        if(line.empty() || line[0]=='#') continue;
+        std::istringstream s(line); int layer,gt,dt; uint64_t off,blob;
+        if(s>>layer>>gt>>dt>>off>>blob && gt==GGML_TYPE_IQ3_XXS && supported(dt)) {
+            p.layer=layer;p.gt=gt;p.dt=dt;p.offset=off;p.blob=blob;break;
+        }
+    }
+    if(p.layer<0) throw std::runtime_error("actual IQ3_XXS layer missing");
+    size_t gu_bytes=matrix_bytes(p.gt,1280,2560), d_bytes=matrix_bytes(p.dt,2560,640);
+    if(gu_bytes+d_bytes!=p.blob) throw std::runtime_error("unexpected actual expert dimensions");
+    std::ifstream file(path+"/experts.bin",std::ios::binary);
+    file.seekg(p.offset);
+    for(int e=0;e<16;++e) {
+        std::vector<uint8_t> gu(gu_bytes),down(d_bytes);
+        file.read((char*)gu.data(),gu.size());file.read((char*)down.data(),down.size());
+        if(!file) throw std::runtime_error("short actual expert read");
+        p.gu.push_back(std::move(gu));p.down.push_back(std::move(down));
+    }
+    std::cout<<"{\"kind\":\"pack\",\"layer\":"<<p.layer<<",\"gate_up_type\":"<<p.gt
+             <<",\"down_type\":"<<p.dt<<",\"first_expert\":0,\"experts\":16,\"offset\":"
+             <<p.offset<<",\"expert_bytes\":"<<p.blob<<"}"<<std::endl;
+    return p;
+}
+struct Case {std::string name;std::vector<int> counts;};
+static std::vector<Case> cases(const std::string &file) {
+    if(file.empty()) return {
+      {"skew_tail",{1,1,2,2,3,4,5,6,8,10,12,16,24,32,64,512}},
+      {"prefill_medium",{61,80,96,112,128,140,160,180,200,220,240,256,300,320,384,512}},
+      {"prefill_large",{128,160,192,224,256,288,320,352,384,416,448,480,512,640,768,1024}}
+    };
+    std::ifstream f(file); if(!f)throw std::runtime_error("cannot read case file");
+    std::string line;std::vector<Case> out;
+    while(std::getline(f,line)) {
+        if(line.empty() || line[0]=='#')continue;
+        std::istringstream s(line); Case c; s>>c.name; int n;
+        while(s>>n)c.counts.push_back(n);
+        if(c.counts.empty() || c.counts.size()>16 ||
+           *std::min_element(c.counts.begin(),c.counts.end())<0 ||
+           std::accumulate(c.counts.begin(),c.counts.end(),0)==0)
+            throw std::runtime_error("invalid case counts");
+        out.push_back(std::move(c));
+    }
+    if(out.size()<3)throw std::runtime_error("need at least three shapes");
+    return out;
+}
+static double median(std::vector<double> v) {std::sort(v.begin(),v.end());return v[v.size()/2];}
+static void run(Context &ctx, hipStream_t stream, const Case &c, int type, int M, int K,
+                const std::vector<std::vector<uint8_t>> &weights, const std::string &role) {
+    const int G=c.counts.size(),R=std::accumulate(c.counts.begin(),c.counts.end(),0);
+    const int maxr=*std::max_element(c.counts.begin(),c.counts.end()),mean=(R+G-1)/G;
+    const size_t wb=matrix_bytes(type,M,K);
+    std::vector<uint8_t> w(wb*G+4096,0);
+    std::vector<int32_t> bounds(G+1,0),src(R),dst(R);
+    for(int e=0;e<G;++e) {
+        if(weights[e].size()!=wb)throw std::runtime_error("weight stride mismatch");
+        std::copy(weights[e].begin(),weights[e].end(),w.begin()+e*wb);
+        bounds[e+1]=bounds[e]+c.counts[e];
+    }
+    std::vector<float>x((size_t)R*K),got((size_t)R*M),base(got.size());
+    for(int r=0;r<R;++r) {
+        src[r]=(r+7)%R;dst[r]=R-1-r;
+        for(int k=0;k<K;++k)
+            x[(size_t)r*K+k]=0.45f*std::sin(.009f*(k+1)+.23f*r)
+               +.17f*std::cos(.021f*(k+3)-.19f*r)
+               +.002f*((k*7+r*13)%19-9);
+    }
+    std::fill(x.end()-K,x.end(),0.0f);
+    Buf dw(w.size()),dx(x.size()*4),ds(R*4),dd(R*4),db(bounds.size()*4),
+        dq(q8_bytes(R,K)),dy(got.size()*4);
+    ck(hipMemcpy(dw.p,w.data(),w.size(),hipMemcpyHostToDevice),"weights");
+    ck(hipMemcpy(dx.p,x.data(),x.size()*4,hipMemcpyHostToDevice),"x");
+    ck(hipMemcpy(ds.p,src.data(),R*4,hipMemcpyHostToDevice),"src");
+    ck(hipMemcpy(dd.p,dst.data(),R*4,hipMemcpyHostToDevice),"dst");
+    ck(hipMemcpy(db.p,bounds.data(),bounds.size()*4,hipMemcpyHostToDevice),"bounds");
+    quantize(dx.as<float>(),ds.as<int32_t>(),dq.p,type,K,K,R,stream);
+    Product p;p.w=dw.p;p.type=type;p.w_rows=M;p.w_cols=K;p.expert_bytes=wb;p.n=G;
+    p.xq=dq.p;p.bounds=db.as<int32_t>();p.ids=dd.as<int32_t>();
+    p.total_rows=R;p.max_rows=maxr;p.dst=dy.as<float>();p.ld_dst=M;
+    std::vector<int> hints={0,std::min(mean,maxr),8,16,24,32,40,48,64};
+    std::vector<int> js;std::vector<bool> exact;
+    double ref2=0,err2=0,maxerr=0,zero=0;int checked=0;
+    for(size_t h=0;h<hints.size();++h) {
+        p.opt_rows=hints[h];
+        ck(hipMemsetAsync(dy.p,0xff,got.size()*4,stream),"sentinel");
+        ctx.run(p,stream);ck(hipStreamSynchronize(stream),"correctness sync");
+        ck(hipMemcpy(got.data(),dy.p,got.size()*4,hipMemcpyDeviceToHost),"output");
+        for(float f:got)if(!std::isfinite(f))throw std::runtime_error("nonfinite or unwritten output");
+        if(h==0)base=got;
+        exact.push_back(std::memcmp(got.data(),base.data(),got.size()*4)==0);
+        js.push_back(selected_j_v07(type,M,hints[h]>0?std::min(hints[h],maxr):maxr));
+        if(!exact.back())throw std::runtime_error("tile-J changed output bytes");
+    }
+    // Sampled FP64 product of the same stored weights against unquantized activation.
+    // This separately checks the existing Q8_1 rounding tolerance; J parity above checks every output byte.
+    const auto* traits=ggml_get_type_traits((ggml_type)type);
+    size_t rb=ggml_row_size((ggml_type)type,K);std::vector<float> wd(K);
+    for(int e=0;e<G;++e) {
+        if(c.counts[e]==0)continue;
+        std::vector<int> rows={bounds[e],bounds[e]+c.counts[e]/2,bounds[e+1]-1};
+        for(int r:rows)for(int j=0;j<17;++j) {
+            int o=(j*149+e*31)%M;traits->to_float(weights[e].data()+o*rb,wd.data(),K);
+            double ref=0;for(int k=0;k<K;++k)ref+=(double)wd[k]*x[(size_t)src[r]*K+k];
+            double d=(double)base[(size_t)dst[r]*M+o]-ref;
+            ref2+=ref*ref;err2+=d*d;maxerr=std::max(maxerr,std::abs(d));++checked;
+        }
+    }
+    for(int r=0;r<R;++r)if(src[r]==R-1)
+        for(int o=0;o<M;++o)zero=std::max(zero,std::abs((double)base[(size_t)dst[r]*M+o]));
+    double rms=std::sqrt(ref2/checked),rl2=std::sqrt(err2/std::max(ref2,1e-300)),mr=maxerr/std::max(rms,1e-300);
+    if(rl2>.04 || mr>.35 || zero>std::max(1e-5,1e-4*rms))throw std::runtime_error("existing Q8_1 FP64 parity gate failed");
+    hipEvent_t a,b;ck(hipEventCreate(&a),"event");ck(hipEventCreate(&b),"event");
+    std::vector<std::vector<double>> times(hints.size());
+    for(size_t h=0;h<hints.size();++h) {p.opt_rows=hints[h];for(int i=0;i<3;++i)ctx.run(p,stream);}
+    ck(hipStreamSynchronize(stream),"prewarm");
+    for(int round=0;round<7;++round)for(size_t q=0;q<hints.size();++q) {
+        size_t h=round%2 ? hints.size()-1-q:q;p.opt_rows=hints[h];
+        ck(hipEventRecord(a,stream),"start");
+        for(int rep=0;rep<20;++rep)ctx.run(p,stream);
+        ck(hipEventRecord(b,stream),"end");ck(hipEventSynchronize(b),"sync");
+        float ms;ck(hipEventElapsedTime(&ms,a,b),"elapsed");times[h].push_back(ms*1000/20);
+    }
+    ck(hipEventDestroy(a),"event free");ck(hipEventDestroy(b),"event free");
+    for(size_t h=0;h<hints.size();++h) {
+        std::cout<<std::setprecision(9)<<"{\"kind\":\"operator\",\"case\":\""<<c.name
+         <<"\",\"role\":\""<<role<<"\",\"type\":"<<type<<",\"M\":"<<M<<",\"K\":"<<K
+         <<",\"experts\":"<<G<<",\"rows\":"<<R<<",\"max_rows\":"<<maxr<<",\"mean_rows\":"<<mean
+         <<",\"hint\":"<<hints[h]<<",\"hint_role\":\""<<(h==0?"max":h==1?"mean":"fixed")
+         <<"\",\"selected_J\":"<<js[h]<<",\"bit_exact\":true,\"ref_sample_count\":"<<checked
+         <<",\"ref_rel_l2\":"<<rl2<<",\"ref_max_over_rms\":"<<mr<<",\"zero_row_max\":"<<zero
+         <<",\"median_us\":"<<median(times[h])<<",\"max_over_candidate\":"<<median(times[0])/median(times[h])
+         <<",\"round_us\":[";
+        for(size_t i=0;i<times[h].size();++i)std::cout<<(i?",":"")<<times[h][i];
+        std::cout<<"],\"counts\":[";
+        for(size_t i=0;i<c.counts.size();++i)std::cout<<(i?",":"")<<c.counts[i];
+        std::cout<<"]}"<<std::endl;
+    }
+}
+int main(int argc,char**argv) {
+    try {
+        if(argc<2 || argc>3)throw std::runtime_error("usage: hip_prefill_mmq_v07 PACK [CASES]");
+        ck(hipSetDevice(0),"device");hipStream_t stream;ck(hipStreamCreateWithFlags(&stream,hipStreamNonBlocking),"stream");
+        Pack p=load_pack(argv[1]);auto shapes=cases(argc==3?argv[2]:"");
+        {Context ctx;for(const auto&c:shapes) {
+            run(ctx,stream,c,p.gt,1280,2560,p.gu,"gate_up");
+            run(ctx,stream,c,p.dt,2560,640,p.down,"down");
+        }}
+        ck(hipStreamDestroy(stream),"stream free");
+        std::cout<<"{\"kind\":\"result\",\"pass\":true,\"shapes\":"<<shapes.size()<<"}"<<std::endl;
+    } catch(const std::exception&e) {std::cerr<<e.what()<<std::endl;return 1;}
+}
