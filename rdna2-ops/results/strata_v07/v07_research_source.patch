diff --git a/src/kernels/cpu/pool_tasks_bench.cpp b/src/kernels/cpu/pool_tasks_bench.cpp
new file mode 100644
index 000000000..f253f5eb2
--- /dev/null
+++ b/src/kernels/cpu/pool_tasks_bench.cpp
@@ -0,0 +1,184 @@
+// CPU-only optional ExpertPool task-granularity microbenchmark.
+//
+// Uses 1 real quantized expert from each requested layer, replicated into
+// independent RAM addresses (16 or 48 expert jobs). No CUDA/ROCm, no inference,
+// no writes to weights/models/OS. Tests bitwise output parity against default
+// tasks=0 for the same 1/4-token synthetic activation.
+// This benchmark is useful for prioritizing --pool-tasks, NOT for
+// predicting real OMP tok/s (model routing, SSD, GPU, Godot are absent).
+//
+// Invocation: pool_tasks_bench MANIFEST EXPERTS_BIN [REPEATS=4]
+// Output: JSONL scalar records; no model paths or generated content.
+#include "strata/kernels/cpu/pool.hpp"
+#include "ggml.h"
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <sstream>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace cpu = strata::kernels::cpu;
+using Clock = std::chrono::steady_clock;
+static double milliseconds(Clock::time_point a, Clock::time_point b) {
+    return std::chrono::duration<double,std::milli>(b-a).count();
+}
+struct Layer {
+    int index=-1, gu=-1, down=-1;
+    uint64_t offset=0, size=0;
+};
+static std::vector<Layer> read_first_layers(const char* filename,bool realistic) {
+    std::ifstream in(filename);
+    if (!in) throw std::runtime_error("cannot open native expert manifest");
+    std::vector<Layer> rows;
+    std::set<std::pair<int,int>> seen_formats;
+    std::string line;
+    while(std::getline(in,line)) {
+        if(line.empty()||line[0]=='#')continue;
+        Layer t;
+        if(!(std::istringstream(line)>>t.index>>t.gu>>t.down>>t.offset>>t.size))
+            throw std::runtime_error("invalid native expert manifest line");
+        if(realistic ? seen_formats.insert({t.gu,t.down}).second : t.index<=2)
+            rows.push_back(t);
+    }
+    if(realistic) {
+        if(rows.size()!=7)throw std::runtime_error("expected 7 model expert formats");
+    } else if(rows.size()!=3||rows[0].index!=0||rows[1].index!=1||rows[2].index!=2)
+        throw std::runtime_error("expected manifest layers 0,1,2");
+    return rows;
+}
+static std::vector<uint8_t> read_one_blob(std::FILE* source,uint64_t offset,size_t n) {
+    if(fseeko(source,(off_t)offset,SEEK_SET)!=0)
+        throw std::runtime_error("expert seek failed");
+    std::vector<uint8_t> data(n);
+    if(std::fread(data.data(),1,n,source)!=n)
+        throw std::runtime_error("expert read failed");
+    return data;
+}
+struct OneCase {
+    cpu::NativeFmt fmt;
+    int layer=0, experts=0, tokens=0;
+    std::vector<std::vector<uint8_t>> blob;
+    std::vector<std::vector<uint8_t>> quant;
+    std::vector<cpu::ActQ> act;
+    std::vector<cpu::ExpertJobMulti> jobs;
+    std::vector<float> outputs;
+    explicit OneCase(const Layer& L,const std::vector<uint8_t>& source,int nexp,int nt)
+        :layer(L.index),experts(nexp),tokens(nt) {
+        std::string err;
+        if(!cpu::native_fmt(L.gu,L.down,cpu::H,cpu::FF,fmt,err))
+            throw std::runtime_error("native format unsupported: "+err);
+        if(fmt.bytes!=source.size())throw std::runtime_error("blob size/format mismatch");
+        if(nt<1||nt>cpu::MAXT)throw std::runtime_error("token count invalid");
+        blob.assign((size_t)nexp,source); // Independent addresses: >96MB at nexp48 and large blob.
+        quant.assign((size_t)nt,std::vector<uint8_t>(fmt.act_bytes));
+        act.resize((size_t)nt);
+        std::vector<float> x((size_t)cpu::H);
+        for(int t=0;t<nt;++t) {
+            for(int i=0;i<cpu::H;++i)
+                x[(size_t)i]=std::sin((float)(i+13*t)*0.031f);
+            cpu::native_quant_act(fmt,x.data(),quant[(size_t)t].data());
+            cpu::act_quant_q8_1(x.data(),cpu::H,act[(size_t)t]);
+        }
+        jobs.resize((size_t)nexp);
+        outputs.resize((size_t)nexp*cpu::MAXT*cpu::H);
+        for(int e=0;e<nexp;++e) {
+            jobs[(size_t)e].blob=blob[(size_t)e].data();
+            jobs[(size_t)e].nt=nt;
+            for(int t=0;t<nt;++t) {
+                jobs[(size_t)e].act[t]=&act[(size_t)t];
+                jobs[(size_t)e].nact[t]=quant[(size_t)t].data();
+                jobs[(size_t)e].out[t]=outputs.data()+((size_t)e*cpu::MAXT+t)*cpu::H;
+            }
+        }
+    }
+};
+int main(int argc,char**argv) {
+    try{
+        if(argc<3||argc>6)throw std::runtime_error("usage: pool_tasks_bench MANIFEST EXPERTS_BIN [REPEATS] [reverse] [realistic]");
+        const int reps=argc>=4?std::atoi(argv[3]):4;
+        bool reverse=false, realistic=false;
+        for(int a=4;a<argc;++a) {
+            const std::string opt=argv[a];
+            if(opt=="reverse"&&!reverse)reverse=true;
+            else if(opt=="realistic"&&!realistic)realistic=true;
+            else throw std::runtime_error("unknown or duplicate benchmark option");
+        }
+        if(reps<2||reps>8)throw std::runtime_error("repeats must be 2..8");
+        // Exactly 1-4MiB demand reads from the legitimate model, and never mmap all 46GiB.
+        std::FILE* f=std::fopen(argv[2],"rb");
+        if(!f)throw std::runtime_error("cannot open expert blob file");
+        const auto layers=read_first_layers(argv[1],realistic);
+        const auto start=Clock::now();
+        int results=0, parity_checks=0;
+        std::vector<int> tasks=realistic ? std::vector<int>{0,24,48,96}
+                                        : std::vector<int>{0,12,24,48,96,192};
+        if(reverse)std::reverse(tasks.begin(),tasks.end());
+        for(const Layer& layer:layers) {
+            cpu::NativeFmt native;
+            std::string err;
+            if(!cpu::native_fmt(layer.gu,layer.down,cpu::H,cpu::FF,native,err)||native.bytes!=layer.size)
+                throw std::runtime_error("invalid pack layout in benchmark");
+            const auto prototype=read_one_blob(f,layer.offset,(size_t)layer.size);
+            const std::vector<int> jobs=realistic ? std::vector<int>{16,24,32}
+                                                   : std::vector<int>{16,48};
+            const std::vector<int> tokens=realistic ? std::vector<int>{4}
+                                                     : std::vector<int>{1,4};
+            for(int nexp:jobs)for(int nt:tokens) {
+                OneCase one(layer,prototype,nexp,nt);
+                cpu::ExpertPool reference_pool(7,true,true,cpu::PoolAffinity::All,0);
+                reference_pool.run_split_multi_native(one.fmt,one.jobs.data(),nexp);
+                const auto reference=one.outputs;
+                for(int task_count:tasks) {
+                    cpu::ExpertPool pool(7,true,true,cpu::PoolAffinity::All,task_count);
+                    // Exclude thread startup + first-touch cache faults from repetitions.
+                    pool.run_split_multi_native(one.fmt,one.jobs.data(),nexp);
+                    if(std::memcmp(reference.data(),one.outputs.data(),one.outputs.size()*sizeof(float))!=0)
+                        throw std::runtime_error("non-bit-identical CPU expert outputs across task counts");
+                    ++parity_checks;
+                    for(int r=0;r<reps;++r) {
+                        const double gu0=pool.ms_multi_gu, q0=pool.ms_multi_q, down0=pool.ms_multi_down;
+                        double pb0=0, pd0=0, pa0=0;
+                        uint64_t pn0=0;
+                        pool.native_phase_ms(pb0,pd0,pa0,pn0);
+                        const auto t0=Clock::now();
+                        pool.run_split_multi_native(one.fmt,one.jobs.data(),nexp);
+                        const auto t1=Clock::now();
+                        double pb1=0, pd1=0, pa1=0;
+                        uint64_t pn1=0;
+                        pool.native_phase_ms(pb1,pd1,pa1,pn1);
+                        if(std::memcmp(reference.data(),one.outputs.data(),one.outputs.size()*sizeof(float))!=0)
+                            throw std::runtime_error("non-bit-identical repeated expert output");
+                        std::printf("{\"layer\":%d,\"gu_type\":%d,\"down_type\":%d,"
+                                    "\"expert_jobs\":%d,\"tokens\":%d,\"pool_tasks\":%d,"
+                                    "\"repetition\":%d,\"wall_ms\":%.4f,\"gu_ms\":%.4f,"
+                                    "\"quant_ms\":%.4f,\"down_ms\":%.4f,"
+                                    "\"native_phase_count\":%llu,\"before_park_ms\":%.4f,"
+                                    "\"drain_ms\":%.4f,\"after_park_ms\":%.4f,"
+                                    "\"pool_threads\":8,\"parity\":\"bit_exact\"}\n",
+                                    layer.index,layer.gu,layer.down,nexp,nt,task_count,r,
+                                    milliseconds(t0,t1),pool.ms_multi_gu-gu0,pool.ms_multi_q-q0,
+                                    pool.ms_multi_down-down0,
+                                    (unsigned long long)(pn1-pn0),pb1-pb0,pd1-pd0,pa1-pa0);
+                        ++results;
+                        if(Clock::now()-start>std::chrono::seconds(28))
+                            throw std::runtime_error("bounded microbenchmark exceeded 28s under external contention");
+                    }
+                }
+            }
+        }
+        std::fclose(f);
+        std::fprintf(stderr,"pool tasks benchmark complete; %d bit-exact settings, %d scalar rows\n",
+                     parity_checks,results);
+        return 0;
+    } catch(const std::exception&ex) {
+        std::fprintf(stderr,"pool tasks benchmark ABORT: %s\n",ex.what());
+        return 2;
+    }
+}
