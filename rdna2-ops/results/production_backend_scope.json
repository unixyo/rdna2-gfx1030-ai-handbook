      "byte_equal": true,
      "optimized_calls": 0
    },
    {
      "input_dtype": "torch.bfloat16",
      "output_dtype": "torch.bfloat16",
      "byte_equal": true,
      "optimized_calls": 0
    },
    {
      "input_dtype": "torch.float32",
      "output_dtype": "torch.bfloat16",
      "byte_equal": true,
      "optimized_calls": 0
    }
  ],
  "rollback_export_restored": true
