{
  "sampler": [
    "KSampler",
    "sample"
  ],
  "sampler_node": "8",
  "model": "qwen",
  "runtime": "~/DevSpace/qwen-image-21-rdna2-lab01/runtime/ComfyUI",
  "workflow": "~/DevSpace/qwen-image-21-rdna2-lab01/workflows/request-gemini-edit-640x960-api.json",
  "decoder": [
    "VAEDecodeTiled",
    "decode"
  ],
  "save_node": "10",
  "attention_target": "comfy.ldm.qwen_image21.model:optimized_attention",
  "env": {
    "Q21_RDNA2_INT8_PATCH": "1",
    "Q21_RDNA2_ENCODER_CPU": "0",
    "Q21_RDNA2_CONV3D_PATCH": "0",
    "Q21_CFG1_PROBE": "0"
  },
  "server_args": [
    "--extra-model-paths-config",
    "~/DevSpace/qwen-image-21-rdna2-lab01/extra_model_paths.yaml",
    "--disable-auto-launch",
    "--disable-triton-backend",
    "--use-split-cross-attention",
    "--reserve-vram",
    "1",
    "--vram-headroom",
    "3"
  ],
  "input_files": [
    "~/DevSpace/rdna2-pro-research-20261102/rehearsal_qwen_20261106/images/ref_image.png"
  ],
  "inputs": {
    "11": {
      "image": "ref_image.png"
    },
    "3": {
      "resolution": 0,
      "prompt": "[private prompt removed: two-character anime illustration edit with a reference image]",
      "negative_prompt": "low quality, blurry, extra fingers, deformed hands, text, watermark"
    }
  }
}
