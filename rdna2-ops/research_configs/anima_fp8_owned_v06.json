{
  "sampler": [
    "KSampler",
    "sample"
  ],
  "sampler_node": "7",
  "model": "anima",
  "runtime": "~/DevSpace/moss-image-rdna2-lab01/runtime/ComfyUI",
  "workflow": "~/DevSpace/anima-rdna2-lab01/workflows/anima_t2i_1024_api.json",
  "decoder": [
    "VAEDecode",
    "decode"
  ],
  "save_node": "9",
  "attention_target": "comfy.ldm.cosmos.predict2:optimized_attention",
  "env": {},
  "server_args": [
    "--extra-model-paths-config",
    "~/DevSpace/anima-rdna2-lab01/extra_model_paths.yaml",
    "--disable-auto-launch",
    "--use-pytorch-cross-attention",
    "--disable-comfy-compiler"
  ],
  "input_files": [],
  "inputs": {
    "1": {
      "weight_dtype": "fp8_e4m3fn"
    }
  },
  "attention_capture_target": "comfy.ops:scaled_dot_product_attention",
  "switch_module": "fp8_owned_switches_v06",
  "fp8_prepared_cache_bytes": 5368709120,
  "research_scope": "Existing Anima BF16 checkpoint is represented as unscaled e4m3fn only in this request. Baseline and candidates use identical FP8 values. Owned FP16 weight+bias request cache; hit bypasses staging context. Existing immutable Anima only, no LoRA generalization.",
  "gpu_audit": true,
  "save_reference_tensors": true,
  "require_bitwise_modes": [
    "fp8_control",
    "fp8_owned_linear"
  ],
  "fp8_int8_allowed_shapes": [
    [
      8192,
      2048,
      2048
    ]
  ],
  "immutable_model_during_request": true
}
